{
  "expo": {
    "name": "fintracker",
    "slug": "fintracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fintracker",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fintracker.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "fintracker uses your photos to attach receipts to transactions."
      }
    },
    "android": {
      "package": "com.fintracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "fintracker",
      "shortName": "fintracker",
      "themeColor": "#0B3D2C",
      "backgroundColor": "#F4F7F5"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3D2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow fintracker to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "fintracker uses your photos to attach receipts to transactions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
